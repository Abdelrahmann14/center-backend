# Copy to .env at this repo's root and fill in. NEVER commit real values here.
# .env is gitignored; this template is not - anything written below ships to
# GitHub. In production nothing reads .env at all: the host injects the same
# names as real environment variables.

# ── Database (Supabase Session Pooler, IPv4-friendly) ──
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>

# Raw password — do NOT URL-encode it. It is handed to the JDBC driver as its
# own parameter, so special characters need no escaping.
DB_PASSWORD=<your-password>

# ── Runtime profile ──
# dev locally; set to prod on the host (disables Swagger, hides stack traces).
SPRING_PROFILES_ACTIVE=dev

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_HOURS=876000

# ── Browser access ──
# Origins allowed to call this API from a browser. Comma-separated, scheme
# included, no trailing slash. Empty = no cross-origin access at all, which is
# correct when the frontend is served from the same origin (dev proxy, desktop
# shell, or a Vercel rewrite). Wildcards allowed for preview deployments:
#   https://center.vercel.app,https://*-yourname.vercel.app
CORS_ALLOWED_ORIGINS=

# ── Google Contacts (People API) OAuth ──
# From Google Cloud Console. The secret is a real credential: never commit it.
# The redirect URI must match one registered on the OAuth client EXACTLY, and
# points at the FRONTEND (it hands the code to the API afterwards).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/

# ── WhatsApp (Green API) ──
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_ENABLED=true

# ── AI message-variant generation (Groq, OpenAI-compatible) ──
# Free key from console.groq.com. Blank = the "generate variants" feature is off.
GROQ_API_KEY=
# Optional overrides:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_ENABLED=true
