# Copy to server/.env and fill in. NEVER commit real values to this template.
# server/.env is gitignored; this file is not.

# Supabase Session Pooler (IPv4-friendly).
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>

# Raw password — do NOT URL-encode it. It is handed to the JDBC driver as its
# own parameter, so special characters need no escaping.
DB_PASSWORD=<your-password>

# ⚠️ Keep in sync with the frontend flag (src/config.ts). false = auth off (dev).
SECURITY_ENABLED=false

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_HOURS=876000

# Google Contacts (People API) OAuth — fill from Google Cloud Console. NEVER commit the real secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/
