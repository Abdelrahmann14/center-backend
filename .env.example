# Copy to .env at this repo's root and fill in. NEVER commit real values here.
# .env is gitignored; this template is not - anything written below ships to
# GitHub. In production nothing reads .env at all: the host injects the same
# names as real environment variables.

# ── Database (Supabase Session Pooler, IPv4-friendly) ──
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>

# Raw password — do NOT URL-encode it. It is handed to the JDBC driver as its
# own parameter, so special characters need no escaping.
DB_PASSWORD=<your-password>

# ── Runtime profile ──
# dev locally; set to prod on the host (disables Swagger, hides stack traces).
SPRING_PROFILES_ACTIVE=dev

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_HOURS=876000

# ── Browser access ──
# Origins allowed to call this API from a browser. Comma-separated, scheme
# included, no trailing slash. Empty = no cross-origin access at all, which is
# correct when the frontend is served from the same origin (dev proxy, desktop
# shell, or a Vercel rewrite). Wildcards allowed for preview deployments:
#   https://center.vercel.app,https://*-yourname.vercel.app
CORS_ALLOWED_ORIGINS=

# ── Google Contacts (People API) OAuth ──
# From Google Cloud Console. The secret is a real credential: never commit it.
# The redirect URI must match one registered on the OAuth client EXACTLY, and
# points at the FRONTEND (it hands the code to the API afterwards).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/

# ── WhatsApp Cloud API (official, hosted by Meta) ──
# The only way this system sends WhatsApp. Blank token = nothing can be sent.
# From developers.facebook.com (app) + business.facebook.com (WABA).
#
# ACCESS_TOKEN is a PERMANENT system-user token with full send + management
# rights over the business's WhatsApp account - treat it like a password. If it
# leaks: Business Settings -> System users -> revoke, then generate a new one.
# APP_SECRET verifies that a webhook call really came from Meta; without it the
# endpoint would accept anything the internet posts at it.
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Any random string; Meta echoes it back on the webhook's GET handshake.
META_WEBHOOK_VERIFY_TOKEN=
# Optional overrides:
# META_API_VERSION=v26.0
# META_ENABLED=true

# ---- WhatsApp number check (Green API) --------------------------------------
# ONLY answers "is this number on WhatsApp". Nothing is ever SENT through it -
# every message goes through Meta above. It is here because Cloud API has no
# endpoint that answers this and Meta will not add one.
#
# One instance for the whole platform, held by the super admin: the answer is a
# property of the number, so it is identical for every teacher and the cache is
# shared between them. Leave blank to turn the check off; nothing else breaks.
# GREEN_CHECK_INSTANCE_ID=
# GREEN_CHECK_TOKEN=
# GREEN_CHECK_TTL=P30D
# GREEN_CHECK_ENABLED=true

# What Meta bills per message, by template category, in USD. Defaults are the
# Egypt rates and they DO change - check Meta's current price list for the
# countries you send to. Only the cost ESTIMATE on the WhatsApp dashboard reads
# these; nothing about sending depends on them.
# META_RATE_MARKETING=0.0736
# META_RATE_UTILITY=0.0104
# META_RATE_AUTH=0.0125
# META_RATE_SERVICE=0
